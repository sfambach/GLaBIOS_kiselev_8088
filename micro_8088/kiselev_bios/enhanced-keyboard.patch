 ; Settings for Book8088
diff --git a/src/keyboard.inc b/src/keyboard.inc
index 534e409..90e18d5 100644
--- a/src/keyboard.inc
+++ b/src/keyboard.inc
@@ -624,4 +624,10 @@ kbd_buffer_init:
 	mov	word [kbd_flags_2],ax
 	mov	word [kbd_flags_3],ax
 	mov	word [kbd_flags_4],ax
+%ifdef KBD_ENHANCED
